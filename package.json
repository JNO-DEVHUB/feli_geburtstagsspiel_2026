  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource/luckiest-guy": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "globals": "16.5.0"
  }
}
