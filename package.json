{
  "name": "felis-grosse-reise",
  "version": "0.1.0",
  "description": "Felis große Reise – ein Geburtstagsspiel fürs Handy (HTML5 Canvas + DOM, ohne Laufzeit-Abhängigkeiten)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
